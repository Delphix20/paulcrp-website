{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "paulcrp-admin-auth",
  "main": "./src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "paulcrp.com/youbecome_analytics*",
      "zone_id": "754fa64b59ce2e57aa72a15e2d3fa13b"
    },
    {
      "pattern": "paulcrp.com/youbecome_content*",
      "zone_id": "754fa64b59ce2e57aa72a15e2d3fa13b"
    }
  ],
  "secrets": {
    "required": ["ADMIN_BASIC_AUTH_SHA256"]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": true,
      "head_sampling_rate": 1
    }
  }
}
